// JobTinder V0.1 baseline Prisma schema
// Stage-1 covers: users, candidate_profiles, companies, jobs, interests, matches,
// contact_methods, notifications(outbox), audit_events, sessions, crawl_runs

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum UserStatus {
  ACTIVE
  PAUSED
  DELETED
}

enum UserRole {
  CANDIDATE
  COMPANY
  BOTH
}

enum Language {
  zh_CN
  en
  km
}

enum ProfileStatus {
  DRAFT
  CONFIRMED
  PAUSED
  DELETED
}

enum SalaryStatus {
  PROVIDED
  NOT_PROVIDED
  NEGOTIABLE
}

enum JobSourceType {
  EXTERNAL
  CLAIMED
}

enum JobStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE_EXTERNAL
  ACTIVE_CLAIMED
  NEEDS_REVIEW
  PAUSED
  CLOSED
}

enum InterestActorSide {
  CANDIDATE
  COMPANY
}

enum InterestStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
  INVALIDATED
  EXPIRED
  MATCHED
}

enum MatchStatus {
  MATCHED
  CONTACT_AVAILABLE
  ENDED
  BLOCKED
  NEEDS_RECONFIRMATION
}

enum ContactMethodType {
  TELEGRAM
  PHONE
  EMAIL
  WHATSAPP
  OTHER
}

enum VerifiedStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  DEAD
}

enum NotificationType {
  INTEREST_RECEIVED
  INTEREST_REMINDER_24H
  INTEREST_PAUSE_72H
  MATCH_CREATED
  PROFILE_CONFIRMED
  JOB_PUBLISHED
  CONTACT_OPENED
  GENERAL
}

enum CrawlJobStatus {
  DISCOVERED
  FETCHED
  PARSED
  TRANSLATED
  QA_PENDING
  REVIEW_REQUIRED
  DEFERRED
  APPROVED
  REJECTED
  PUBLISHED
  PAUSED
  STALE
  EXPIRED
  CLOSED
}

enum SourceParserType {
  STATIC_HTML
  PLAYWRIGHT
  FIRECRAWL
  MANUAL
  API
  RSS
}

enum WorkMode {
  REMOTE
  ONSITE
  HYBRID
}

enum RemoteScope {
  WORLDWIDE
  ASIA
  ASEAN
  CAMBODIA_ONLY
  COUNTRY_LIMITED
}

enum WorkAuthorization {
  REQUIRED
  NOT_REQUIRED
  UNKNOWN
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  FREELANCE
  INTERNSHIP
}

enum EligibilityStatus {
  CONFIRMED
  NEEDS_CONFIRMATION
  NOT_ELIGIBLE
}

enum ApplicationStatus {
  SAVED
  APPLYING
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  REJECTED
  EXPIRED
}

enum SourceReviewStatus {
  PENDING
  APPROVED
  REJECTED
  DEFERRED
  SUSPENDED
}

enum CrawlQAStatus {
  NOT_RUN
  PASSED
  FAILED
  REVIEW_REQUIRED
}

enum CrawlTranslationStatus {
  NOT_STARTED
  IN_PROGRESS
  DONE
  FAILED
}

enum CandidateJobSearchStatus {
  LOOKING_JOB
  INTERVIEWING
  FOUND_JOB
  NOT_LOOKING
}

enum CompanyHiringStatus {
  OPEN
  INTERVIEWING
  FILLED
  CLOSED
  CANCELLED
}

enum StatusSource {
  MANUAL
  INFERRED
}

enum AuditAction {
  USER_CREATED
  USER_LANGUAGE_CHANGED
  PROFILE_DRAFT_CREATED
  PROFILE_DRAFT_UPDATED
  PROFILE_CONFIRMED
  PROFILE_PAUSED
  PROFILE_RESUMED
  PROFILE_DELETED
  COMPANY_VERIFIED
  JOB_DRAFT_CREATED
  JOB_CONFIRMED
  JOB_CLAIMED
  JOB_CLOSED
  JOB_PUBLISHED_FROM_CRAWL
  INTEREST_RECORDED
  INTEREST_ACCEPTED
  INTEREST_DECLINED
  INTEREST_WITHDRAWN
  INTEREST_EXPIRED_PAUSED
  MATCH_CREATED
  MATCH_ENDED
  MATCH_BLOCKED
  CONTACT_OPENED
  NOTIFY_QUEUED
  NOTIFY_SUCCEEDED
  NOTIFY_FAILED_DEAD
  CRAWL_RUN_STARTED
  CRAWL_RUN_FINISHED
  CRAWL_SOURCE_REGISTERED
  CRAWL_JOB_DISCOVERED
  CRAWL_JOB_PARSED
  CRAWL_TRANSLATION_DONE
  CRAWL_QA_FLAGGED
  CRAWL_REVIEW_APPROVED
  CRAWL_REVIEW_REJECTED
  CRAWL_JOB_PUBLISHED
  CRAWL_JOB_MARKED_STALE
  SOURCE_DISCOVERED
  SOURCE_IMPORTED
  SOURCE_VALIDATED
  SOURCE_APPROVED
  SOURCE_REJECTED
  SOURCE_SUSPENDED
  SOURCE_DEFERRED
  JOB_DEFERRED
  JOB_RETRANSLATED
  MATCH_INTERESTED_CANDIDATE
  MATCH_INTERESTED_COMPANY
  MATCH_CONTACT_OPENED
  CANDIDATE_STATUS_CHANGED
  COMPANY_JOB_STATUS_CHANGED
  TRUST_REPORT_SUBMITTED
  TRUST_BLOCK_EFFECTIVE
  REMOTE_SOURCE_SYNCED
  REMOTE_JOB_NORMALIZED
  REMOTE_ELIGIBILITY_CHECKED
  REMOTE_DAILY_DIGEST_SENT
  JOB_APPLICATION_STATUS_CHANGED
  FOLLOW_UP_REMINDER_SENT
}

// ---------- Users ----------

model users {
  id              BigInt     @id @default(autoincrement())
  telegram_user_id BigInt    @unique
  telegram_username String?  @db.VarChar(128)
  telegram_first_name String? @db.VarChar(256)
  telegram_last_name String?  @db.VarChar(256)
  language        Language   @default(en)
  preferred_role  UserRole?
  status          UserStatus @default(ACTIVE)
  created_at      DateTime   @default(now())
  updated_at      DateTime   @updatedAt

  candidate_profiles candidate_profiles[]
  companies          companies_members[]
  contact_methods    contact_methods[]
  sessions           sessions[]
  audit_events       audit_events[]
  outbox             notifications[] @relation("outbox_recipient")
}

// ---------- Candidate Profiles ----------

model candidate_profiles {
  id                BigInt       @id @default(autoincrement())
  user_id           BigInt
  version           Int          @default(1)
  status            ProfileStatus @default(DRAFT)

  skills            String[]     @default([])
  industries        String[]     @default([])
  target_roles      String[]     @default([])
  task_keywords     String[]     @default([])
  locations         String[]     @default([])
  languages_known   String[]     @default([])

  salary_status     SalaryStatus @default(NOT_PROVIDED)
  salary_text       String?      @db.VarChar(256)

  availability_note String?      @db.VarChar(512)

  job_search_status              CandidateJobSearchStatus @default(LOOKING_JOB)
  job_search_status_updated_at   DateTime?
  job_search_status_source       StatusSource @default(MANUAL)

  remote_preferred                     Boolean              @default(false)
  remote_scope_preference              RemoteScope?
  timezone                             String?              @db.VarChar(64)
  timezone_overlap_hours               Int?
  eligible_work_countries              String[]             @default([])
  work_authorization_status            WorkAuthorization    @default(UNKNOWN)
  preferred_employment_types           EmploymentType[]     @default([])
  payment_methods                      String[]             @default([])
  remote_salary_expectation            String?              @db.VarChar(256)

  field_sources     Json         @default("{}") // { skills: 'ai_extracted'|'user_confirmed', ... }

  draft_source      String?      @db.VarChar(64) // manual / ai / mock
  ai_provider_id    String?      @db.VarChar(64)

  confirmed_at      DateTime?
  deleted_at        DateTime?
  created_at        DateTime     @default(now())
  updated_at        DateTime     @updatedAt

  user              users        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  interests         interests[]  @relation("candidate_interests")
  matches           matches[]    @relation("candidate_matches")
  job_applications  job_applications[]

  @@unique([user_id, version], name: "cand_user_version_uq")
  @@index([user_id, status])
}

// ---------- Companies & members ----------

model companies {
  id                  BigInt       @id @default(autoincrement())
  name                String       @db.VarChar(256)
  website             String?      @db.VarChar(512)
  description         String?      @db.VarChar(2000)
  industry            String?      @db.VarChar(128)
  size                String?      @db.VarChar(64)
  location            String?      @db.VarChar(256)
  recruiter_name      String?      @db.VarChar(256)
  recruiter_role      String?      @db.VarChar(128)
  verification_status VerifiedStatus @default(UNVERIFIED)
  verified_at         DateTime?
  created_at          DateTime     @default(now())
  updated_at          DateTime     @updatedAt

  members             companies_members[]
  jobs                jobs[]
  crawl_sources       source_registry[]
}

model companies_members {
  id          BigInt @id @default(autoincrement())
  company_id  BigInt
  user_id     BigInt
  role        String @db.VarChar(64) // owner / hr / recruiter
  is_owner    Boolean @default(false)
  joined_at   DateTime @default(now())

  company     companies @relation(fields: [company_id], references: [id], onDelete: Cascade)
  user        users     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([company_id, user_id], name: "company_member_uq")
  @@index([user_id])
}

// ---------- Jobs ----------

model jobs {
  id                BigInt       @id @default(autoincrement())
  company_id        BigInt?
  source_type       JobSourceType @default(EXTERNAL)
  source_url        String?      @db.VarChar(2048)
  source_job_id     String?      @db.VarChar(256)
  idempotency_key   String?      @db.VarChar(512) @unique

  title             String       @db.VarChar(512)
  industry          String?      @db.VarChar(128)
  skills            String[]     @default([])
  tasks             String[]     @default([])
  locations         String[]     @default([])
  languages_required String[]    @default([])
  shifts            String[]     @default([])

  salary_status     SalaryStatus @default(NOT_PROVIDED)
  salary_text       String?      @db.VarChar(256)

  work_mode                     WorkMode           @default(ONSITE)
  remote_scope                  RemoteScope?
  eligible_countries            String[]           @default([])
  employer_country              String?            @db.VarChar(128)
  timezone_required             String?            @db.VarChar(64)
  timezone_overlap_hours        Int?
  work_authorization            WorkAuthorization  @default(UNKNOWN)
  employment_type               EmploymentType?
  payment_method                String?            @db.VarChar(128)
  salary_currency               String?            @db.VarChar(16)
  application_url               String?            @db.VarChar(2048)
  source_platform               String?            @db.VarChar(128)
  source_last_seen_at           DateTime?
  eligibility_status            EligibilityStatus  @default(NEEDS_CONFIRMATION)

  original_published_at DateTime?
  original_deadline_at  DateTime?
  last_checked_at       DateTime?
  expiry_date           DateTime?
  last_confirmed_at     DateTime?

  version               Int          @default(1)
  status                JobStatus    @default(DRAFT)

  hiring_status              CompanyHiringStatus @default(OPEN)
  hiring_status_updated_at   DateTime?
  hiring_status_source       StatusSource @default(MANUAL)

  created_at            DateTime     @default(now())
  updated_at            DateTime     @updatedAt
  closed_at             DateTime?
  closed_reason         String?      @db.VarChar(1024)

  company           companies?   @relation(fields: [company_id], references: [id])
  interests         interests[]  @relation("job_interests")
  matches           matches[]    @relation("job_matches")
  published_from_crawl crawl_jobs_staging?
  job_applications  job_applications[]

  @@unique([source_job_id, source_type], name: "job_source_uq")
  @@index([status])
  @@index([company_id, status])
}

// ---------- Interests ----------

model interests {
  id                BigInt           @id @default(autoincrement())
  idempotency_key   String           @unique @db.VarChar(512)

  candidate_id      BigInt
  job_id            BigInt
  actor_side        InterestActorSide

  candidate_version Int
  job_version       Int

  status            InterestStatus   @default(PENDING)
  version           Int              @default(1)

  notified_at       DateTime?
  reminded_at       DateTime?
  processed_at      DateTime?
  expires_at        DateTime?

  created_at        DateTime         @default(now())
  updated_at        DateTime         @updatedAt

  candidate         candidate_profiles @relation("candidate_interests", fields: [candidate_id], references: [id])
  job               jobs             @relation("job_interests", fields: [job_id], references: [id])

  @@unique([candidate_id, job_id, actor_side, version], name: "interest_cand_job_actor_ver_uq")
  @@index([job_id, status])
  @@index([candidate_id, status])
  @@index([status, notified_at])
}

// ---------- Matches ----------

model matches {
  id                BigInt       @id @default(autoincrement())
  idempotency_key   String       @unique @db.VarChar(512)

  candidate_id      BigInt
  job_id            BigInt
  candidate_interest_id BigInt
  company_interest_id   BigInt

  version           Int          @default(1)
  status            MatchStatus  @default(CONTACT_AVAILABLE)

  created_at        DateTime     @default(now())
  contact_opened_at DateTime     @default(now())
  ended_at          DateTime?

  candidate         candidate_profiles @relation("candidate_matches", fields: [candidate_id], references: [id])
  job               jobs             @relation("job_matches", fields: [job_id], references: [id])

  @@unique([candidate_id, job_id], name: "match_cand_job_uq")
  @@index([status])
}

// ---------- Contact Methods (value_ref - not plaintext in DB) ----------

model contact_methods {
  id              BigInt            @id @default(autoincrement())
  user_id         BigInt

  type            ContactMethodType
  value_ref       String            @db.VarChar(1024) // encrypted/remote ref; NEVER plaintext
  label           String?           @db.VarChar(128)
  share_enabled   Boolean           @default(false)
  verified_status VerifiedStatus    @default(UNVERIFIED)
  created_at      DateTime          @default(now())
  updated_at      DateTime          @updatedAt

  user            users             @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, type], name: "user_contact_type_uq")
}

// ---------- Notifications Outbox ----------

model notifications {
  id               BigInt             @id @default(autoincrement())
  dedupe_key       String             @unique @db.VarChar(512)

  recipient_id     BigInt
  type             NotificationType
  payload          Json               @default("{}")

  status           OutboxStatus       @default(PENDING)
  attempts         Int                @default(0)
  max_attempts     Int                @default(8)
  last_error_code  String?            @db.VarChar(128)
  last_error_desc  String?            @db.VarChar(1024)

  external_ref     String?            @db.VarChar(512) // e.g. telegram msg_id hash, email messageId
  note_succeeded   String?            @db.VarChar(1024)

  available_after  DateTime           @default(now())
  created_at       DateTime           @default(now())
  processed_at     DateTime?

  recipient        users              @relation("outbox_recipient", fields: [recipient_id], references: [id], onDelete: Cascade)

  @@index([status, available_after])
  @@index([recipient_id, created_at])
}

// ---------- Audit Events ----------

model audit_events {
  id           BigInt       @id @default(autoincrement())
  actor_id     BigInt?
  action       AuditAction
  object_type  String       @db.VarChar(64)
  object_id    BigInt?
  version      Int?
  metadata     Json         @default("{}") // NEVER store PII

  created_at   DateTime     @default(now())

  actor        users?       @relation(fields: [actor_id], references: [id], onDelete: SetNull)

  @@index([actor_id, created_at])
  @@index([object_type, object_id, created_at])
  @@index([action, created_at])
}

// ---------- Sessions (grammY persistent storage) ----------

model sessions {
  session_key  String    @id @db.VarChar(512)
  session_data Json      @default("{}")
  user_id      BigInt?
  expires_at   DateTime
  updated_at   DateTime  @updatedAt

  user         users?    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
}

// ---------- Source Registry ----------

model source_registry {
  id                    BigInt             @id @default(autoincrement())
  name                  String             @db.VarChar(256)
  company_id            BigInt?
  base_url              String             @db.VarChar(2048)
  jobs_url              String             @db.VarChar(2048)
  // OFFICIAL_COMPANY_WEBSITE | GOVERNMENT_JOB_PORTAL | CHAMBER_DIRECTORY | THIRD_PARTY_JOB_BOARD | SOCIAL_PAGE
  source_type           String             @default("OFFICIAL_COMPANY_WEBSITE") @db.VarChar(64)
  parser_type           SourceParserType   @default(STATIC_HTML)
  enabled               Boolean            @default(false)
  crawl_interval_minutes Int               @default(360)
  last_crawled_at       DateTime?
  last_success_at       DateTime?
  robots_status         String?            @db.VarChar(32) // ALLOWED / DISALLOWED / UNCHECKED
  terms_checked_at      DateTime?
  review_status         SourceReviewStatus @default(PENDING)
  discovery_method      String?            @db.VarChar(64)
  city                  String?            @db.VarChar(64)
  industry              String?            @db.VarChar(128)
  verification_notes    String?            @db.VarChar(2000)
  verified_at           DateTime?
  verified_by           String?            @db.VarChar(128)
  verification_score    Int?
  last_validation_at    DateTime?
  validation_error      String?            @db.VarChar(1024)
  source_notified_at    DateTime?
  suspended_at          DateTime?
  disable_reason        String?            @db.VarChar(1024)
  created_at            DateTime           @default(now())
  updated_at            DateTime           @updatedAt

  crawl_runs            crawl_runs[]
  crawl_snapshots       crawl_snapshots[]
  crawl_jobs_staging    crawl_jobs_staging[]
  company               companies?         @relation(fields: [company_id], references: [id], onDelete: SetNull)

  @@unique([base_url, jobs_url], name: "source_base_jobs_url_uq")
  @@index([enabled, review_status, last_crawled_at])
}

// ---------- Crawl Snapshots (原始网页证据，仅存追溯用) ----------

model crawl_snapshots {
  id              BigInt   @id @default(autoincrement())
  source_id       BigInt
  url             String   @db.VarChar(2048)
  http_status     Int?
  content_hash    String   @db.VarChar(128) // sha256 hex
  raw_content     Bytes?   // 仅审核追溯用，不对外暴露
  content_type    String?  @db.VarChar(128)
  fetched_at      DateTime @default(now())
  parser_version  String   @db.VarChar(64) @default("1.0")
  error_code      String?  @db.VarChar(64) // HTTP_403 / HTTP_429 / TIMEOUT / PARSE_ERROR
  error_message   String?  @db.VarChar(2048)

  source          source_registry @relation(fields: [source_id], references: [id], onDelete: Cascade)
  crawl_jobs_staging crawl_jobs_staging[]

  @@unique([source_id, content_hash])
  @@index([source_id, fetched_at])
}

// ---------- Crawl Jobs Staging (未审核的岗位暂存) ----------

model crawl_jobs_staging {
  id                  BigInt                @id @default(autoincrement())
  source_id           BigInt
  snapshot_id         BigInt?
  source_job_id       String                @db.VarChar(256)
  source_url          String                @db.VarChar(2048)
  status              CrawlJobStatus        @default(DISCOVERED)
  detected_language   String?               @db.VarChar(16) // km / en / zh_CN / unknown
  title_source        String?               @db.VarChar(512)
  tasks_source        String?               @db.VarChar(4000)
  skills_source       String?               @db.VarChar(2000)
  industry_source     String?               @db.VarChar(128)
  locations_source    String?               @db.VarChar(2000)
  salary_source       String?               @db.VarChar(256)
  shift_source        String?               @db.VarChar(1000)
  benefits_source     String?               @db.VarChar(2000)
  parsed_json         Json                  @default("{}")
  translation_status  CrawlTranslationStatus @default(NOT_STARTED)
  qa_status           CrawlQAStatus         @default(NOT_RUN)
  review_status       CrawlQAStatus         @default(NOT_RUN)
  reject_reason       String?               @db.VarChar(2000)
  parse_version       String                @db.VarChar(64) @default("1.0")
  published_job_id    BigInt?               @unique
  qa_flags            String[]              @default([])

  work_mode                     WorkMode           @default(ONSITE)
  remote_scope                  RemoteScope?
  eligible_countries            String[]           @default([])
  employer_country              String?            @db.VarChar(128)
  timezone_required             String?            @db.VarChar(64)
  timezone_overlap_hours        Int?
  work_authorization            WorkAuthorization  @default(UNKNOWN)
  employment_type               EmploymentType?
  payment_method                String?            @db.VarChar(128)
  salary_currency               String?            @db.VarChar(16)
  application_url               String?            @db.VarChar(2048)
  source_platform               String?            @db.VarChar(128)
  source_last_seen_at           DateTime?
  eligibility_status            EligibilityStatus  @default(NEEDS_CONFIRMATION)

  expiry_date         DateTime?
  last_confirmed_at   DateTime?
  closed_reason       String?               @db.VarChar(1024)
  created_at          DateTime              @default(now())
  updated_at          DateTime              @updatedAt
  review_notified_at   DateTime?

  source              source_registry       @relation(fields: [source_id], references: [id], onDelete: Cascade)
  snapshot            crawl_snapshots?      @relation(fields: [snapshot_id], references: [id], onDelete: SetNull)
  job_translations    job_translations[]
  published_job       jobs?                 @relation(fields: [published_job_id], references: [id], onDelete: SetNull)

  @@unique([source_id, source_job_id, parse_version], name: "crawl_staging_source_job_ver_uq")
  @@index([source_id, status])
  @@index([status, created_at])
}

// ---------- Job Translations (三语结构化) ----------

model job_translations {
  id                   BigInt       @id @default(autoincrement())
  staging_job_id       BigInt
  language             Language
  title                String       @db.VarChar(512)
  tasks                String[]     @default([])
  skills               String[]     @default([])
  industry             String?      @db.VarChar(128)
  locations            String[]     @default([])
  salary_text          String?      @db.VarChar(256)
  shifts               String[]     @default([])
  benefits             String[]     @default([])
  translation_provider String?      @db.VarChar(64) // deepseek / mock / ollama
  translation_model    String?      @db.VarChar(128)
  translation_version  String       @db.VarChar(64) @default("1.0")
  qa_status            CrawlQAStatus @default(NOT_RUN)
  review_status        CrawlQAStatus @default(NOT_RUN)
  review_notes         String?      @db.VarChar(2000)
  warnings             String[]     @default([])
  created_at           DateTime     @default(now())
  updated_at           DateTime     @updatedAt

  staging_job          crawl_jobs_staging @relation(fields: [staging_job_id], references: [id], onDelete: Cascade)

  @@unique([staging_job_id, language, translation_version], name: "job_trans_staging_lang_ver_uq")
  @@index([language])
}

// ---------- Crawl Runs ----------

model crawl_runs {
  id                    BigInt       @id @default(autoincrement())
  source_id             BigInt
  started_at            DateTime     @default(now())
  finished_at           DateTime?
  status                OutboxStatus @default(PROCESSING)
  new_count             Int          @default(0)
  changed_count         Int          @default(0)
  closed_count          Int          @default(0)
  translated_count      Int          @default(0)
  review_required_count Int          @default(0)
  error_count           Int          @default(0)
  last_error            String?      @db.VarChar(2048)

  source                source_registry @relation(fields: [source_id], references: [id], onDelete: Cascade)

  @@index([source_id, started_at])
}

// ---------- Job Applications (投递追踪) ----------

model job_applications {
  id                BigInt            @id @default(autoincrement())
  idempotency_key   String            @unique @db.VarChar(512)

  candidate_id      BigInt
  job_id            BigInt

  application_url   String?           @db.VarChar(2048)
  applied_at        DateTime?
  status            ApplicationStatus @default(SAVED)
  next_follow_up_at DateTime?
  last_action_at    DateTime?
  notes             String?           @db.VarChar(4000)

  version           Int               @default(1)
  created_at        DateTime          @default(now())
  updated_at        DateTime          @updatedAt

  candidate         candidate_profiles @relation(fields: [candidate_id], references: [id], onDelete: Cascade)
  job               jobs             @relation(fields: [job_id], references: [id], onDelete: Cascade)

  @@unique([candidate_id, job_id], name: "application_cand_job_uq")
  @@index([candidate_id, status])
  @@index([job_id, status])
  @@index([status, next_follow_up_at])
}
