# ---------- Runtime ----------
NODE_ENV=development
PORT=3000

# ---------- Database ----------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jobtinder?schema=public"

# ---------- Telegram ----------
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
TELEGRAM_WEBHOOK_URL=
TELEGRAM_SESSION_SALT=change-this-to-a-long-random-string

# ---------- AI Providers (stage-1 defaults to mock, leave empty) ----------
AI_DEFAULT_PROVIDER=mock

AI_OLLAMA_BASE_URL=http://localhost:11434
AI_OLLAMA_MODEL=llama3.1

AI_DEEPSEEK_API_KEY=
AI_DEEPSEEK_MODEL=deepseek-chat

AI_OPENAI_COMPATIBLE_API_KEY=
AI_OPENAI_COMPATIBLE_BASE_URL=
AI_OPENAI_COMPATIBLE_MODEL=

# ---------- Security ----------
APP_HASH_PEPPER=change-this-to-another-long-random-string-32chars-min

# ---------- Outbox Worker ----------
OUTBOX_WORKER_ENABLED=true
OUTBOX_WORKER_POLL_INTERVAL_MS=2000
OUTBOX_WORKER_BATCH_SIZE=100
OUTBOX_WORKER_MAX_ATTEMPTS=8

# ---------- Crawler (Source Registry + Pipeline) ----------
CRAWLER_ENABLED=false
CRAWLER_CRON_EXPRESSION=0 */30 * * * *
CRAWLER_INTERNAL_TOKEN=change-this-internal-api-token-64chars
CRAWLER_REQUEST_TIMEOUT_MS=20000
CRAWLER_MAX_RETRIES=2
CRAWLER_MIN_INTERVAL_MS=2000
CRAWLER_MAX_INTERVAL_MS=5000
CRAWLER_DAILY_PAGE_LIMIT_PER_SOURCE=200
ALLOW_NON_HTTPS_SOURCES=false

# ---------- Remote Jobs (Source Feeds + Daily Digest) ----------
# Phase-1 sources: Remotive API/RSS + Remote OK RSS; LinkedIn/Indeed/Arc later
REMOTE_SOURCE_SYNC_CRON=0 0 */6 * * *
REMOTE_NORMALIZE_CRON=0 30 */6 * * *
REMOTE_ELIGIBILITY_CRON=0 0 7 * * *
REMOTE_DAILY_DIGEST_CRON=0 0 9 * * *
# Override endpoints only when using a local cache/proxy for staging tests
# REMOTIVE_API_BASE_URL=https://remotive.com/api/remote-jobs
# REMOTIVE_RSS_URL=https://remotive.com/remote-jobs/feed
# REMOTE_OK_RSS_URL=https://remoteok.com/remote-jobs.rss
